{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://majestios.fr/schemas/opportunite.schema.json",
  "title": "Opportunité d'appel d'offres MajestiOS",
  "description": "Modèle normalisé pour une annonce vérifiée issue d'une source identifiable. Ce schéma ne constitue pas une connexion aux sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "category",
    "marketType",
    "source",
    "sourceUrl",
    "publishedAt",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifiant interne stable, distinct de l'identifiant source."
    },
    "sourceId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Identifiant attribué par la plateforme source."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "services",
        "travaux",
        "conseil",
        "batiment",
        "renovation",
        "electricite",
        "plomberie",
        "maintenance"
      ]
    },
    "marketType": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "buyerName": {
      "type": [
        "string",
        "null"
      ],
      "description": "Acheteur ou donneur d'ordre, uniquement si publié par la source."
    },
    "location": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "postalCode": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9A-Za-z -]{2,12}$"
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "departmentCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "regionCode": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deadlineAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Nom de la source consultée."
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "description": "URL de la fiche source officielle ou autorisée."
    },
    "documentUrls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "updated",
        "closed",
        "withdrawn",
        "to_verify"
      ]
    },
    "verifiedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lastSeenAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "lots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "default": []
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrievedAt",
        "method"
      ],
      "properties": {
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string",
          "enum": [
            "api",
            "feed",
            "authorized_scraping",
            "manual_review"
          ]
        },
        "rawRecordHash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
