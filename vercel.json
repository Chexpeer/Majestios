{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/prospection-inversee.html",
      "destination": "/prospection-active.html",
      "permanent": true
    },
    {
      "source": "/zone-artisanale.html",
      "destination": "/index.html#accueil",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/IMMEUBLE.jfif",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ],
  "functions": {
    "api/reputation-audit-analyze.ts": {
      "maxDuration": 60
    }
  }
}
